# ---- Lodestar configuration -------------------------------------------------
# Copy to .env and edit. Every value below has a working default: the app runs
# completely with no API key and no internet connection.

# ---- Text generation --------------------------------------------------------
# mock    offline and deterministic. Everything works; the wording is templated.
# ollama  a small model on this machine. No key, no quota  (see below).
# gemini  a hosted model. Needs GEMINI_API_KEY.
# auto    use Ollama if its daemon is running, otherwise mock.
LLM_PROVIDER=auto

# ---- Ollama (local, recommended) --------------------------------------------
# Install from https://ollama.com, then:  ollama pull llama3.2:1b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# 0 = use the physical core count, which beat the logical count in testing.
OLLAMA_THREADS=0
OLLAMA_NUM_CTX=4096

# ---- Gemini (optional) ------------------------------------------------------
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Embeddings (always local, never an API) --------------------------------
# auto     BAAI/bge-small-en-v1.5 via ONNX; ~130 MB downloaded once, then offline
# hashing  no model at all, a deterministic lexical vectoriser
EMBEDDER=auto

# ---- Storage ----------------------------------------------------------------
# Leave unset to use <repo-root>/lodestar.db. Any SQLAlchemy URL works.
# DATABASE_URL=sqlite:///./lodestar.db

# ---- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Planner and diagnostic tuning ------------------------------------------
MASTERY_THRESHOLD=0.7
SELF_REPORT_CAP=0.4
DIAGNOSTIC_MAX_QUESTIONS=8
DIAGNOSTIC_CONFIDENCE_TARGET=0.75

LOG_LEVEL=INFO

# Build a curriculum for goals the curated graph does not cover.
# Needs Ollama; set to false for strictly closed-world behaviour.
EXPANSION_ENABLED=true
EXPANSION_RESOURCES_PER_SKILL=3
