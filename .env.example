# ---- Lodestar configuration -------------------------------------------------
# Copy to .env and edit. Every value below has a working default: the app runs
# with no API key and no internet connection, just slower -- an OpenRouter key
# (free, see below) is what makes conversations fast. start.bat asks for one
# on first run.

# ---- Text generation --------------------------------------------------------
# mock        offline and deterministic. Everything works; the wording is templated.
# ollama      a small model on this machine. No key, no quota  (see below).
# openrouter  hosted, free models only. Fast, and rate-limited without warning.
# gemini      a hosted model. Needs GEMINI_API_KEY.
# auto        a chain: OpenRouter if a key is set, then Ollama, then mock. Each
#             falls through to the next, so a throttled hosted model degrades
#             to a slow local one rather than to an error.
LLM_PROVIDER=auto

# ---- Ollama (local, recommended) --------------------------------------------
# Install from https://ollama.com, then:  ollama pull llama3.2:1b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# 0 = use the physical core count, which beat the logical count in testing.
OLLAMA_THREADS=0
OLLAMA_NUM_CTX=4096

# ---- OpenRouter (hosted, free models only) -----------------------------------
# Optional, and the reason the conversation feels like a conversation: a local
# 3B model on a laptop CPU takes ~43 s to read an intake message, which the
# latency budgets below correctly refuse to wait for, so replies fall back to
# templates. A hosted free model answers the same message in ~3 s.
#
# Only models priced at exactly zero are ever selected, the list is discovered
# from OpenRouter's own catalogue rather than hardcoded, and any model that
# reports a cost is dropped immediately. Get a free key at
# https://openrouter.ai/keys -- no card required.
OPENROUTER_API_KEY=
# Optional preference, e.g. z-ai/glm-5.2:free. Ignored unless the catalogue
# agrees the model is free, so this cannot start a bill by accident.
OPENROUTER_MODEL=

# ---- Gemini (optional) ------------------------------------------------------
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Embeddings (always local, never an API) --------------------------------
# auto     BAAI/bge-small-en-v1.5 via ONNX; ~130 MB downloaded once, then offline
# hashing  no model at all, a deterministic lexical vectoriser
EMBEDDER=auto

# ---- Storage ----------------------------------------------------------------
# Leave unset to use <repo-root>/lodestar.db. Any SQLAlchemy URL works.
# DATABASE_URL=sqlite:///./lodestar.db

# ---- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Planner and diagnostic tuning ------------------------------------------
MASTERY_THRESHOLD=0.7
SELF_REPORT_CAP=0.4
DIAGNOSTIC_MAX_QUESTIONS=8
DIAGNOSTIC_CONFIDENCE_TARGET=0.75

# ---- Latency budgets --------------------------------------------------------
# How long a model may take on a turn someone is waiting through -- an intake
# reply, a chat answer, resolving a goal. Every one of those has a
# deterministic answer already computed, so exceeding the budget costs
# phrasing, never correctness. Raise it if you would rather wait.
INTERACTIVE_BUDGET_SECONDS=25
# The same idea for the per-item prose on a plan, which is many calls, not one.
# One batched request for the whole plan, not one call per step --
# so this is the wait for a single reply, not the sum of a dozen.
NARRATION_BUDGET_SECONDS=20

LOG_LEVEL=INFO

# Build a curriculum for goals the curated graph does not cover.
# Needs Ollama; set to false for strictly closed-world behaviour.
EXPANSION_ENABLED=true
EXPANSION_RESOURCES_PER_SKILL=3
