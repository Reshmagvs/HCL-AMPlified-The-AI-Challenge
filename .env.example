# ---- Lodestar configuration -------------------------------------------------
# Copy to .env and fill in. Everything below has a working default: the app runs
# fully with no API key at all (LLM_PROVIDER=mock).

# Which LLM provider to use: "mock" (offline, deterministic) or "gemini" (live).
LLM_PROVIDER=mock

# Google AI Studio key -- free, no card: https://aistudio.google.com/apikey
# Only needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Model ids
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Database (SQLite by default; any SQLAlchemy URL works)
# Leave unset to use <repo-root>/lodestar.db. Any SQLAlchemy URL works.
# DATABASE_URL=sqlite:///./lodestar.db

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Planner / diagnostic tuning
MASTERY_THRESHOLD=0.7
SELF_REPORT_CAP=0.4
DIAGNOSTIC_MAX_QUESTIONS=10
DIAGNOSTIC_CONFIDENCE_TARGET=0.75

# Logging
LOG_LEVEL=INFO
